<div class="container mt-4">
    <div class="row mb-5">
        <h2 class="text-white mb-3">
            Gestión de Proveedores
        </h2>
        <div class="col-md-5">
            {{> proveedores/proveedorForm}}
        </div>
        <div class="col-md-7">
            <form action="/proveedores" method="get" class="mb-3">    
                <div class="input-group">
                    <input type="text" name="busqueda" class="form-control" placeholder="Buscar proveedor..." value="{{busqueda}}">
                    <button class="btn btn-success" type="submit">
                    <img src="/icons/Buscar.jpg" style="width: 25px; height: 25px;">
                        Buscar
                    </button>
                    <a href="/proveedores" class="btn btn-secondary">
                        Limpiar
                    </a>
                </div>
            </form>
            {{> proveedores/proveedorTabla}}
        </div>
    </div>
</div>