<div class="container mt-5">
    <div class="text-center text-white">
        <h1 class="mb-4">
            MongoTienda
        </h1>
        <p class="mb-5">
            Sistema de gestión de productos y proveedores
        </p>
        {{#if usuarioSesion}}
        <div class="alert bg-dark text-light border border-light p-4 shadow" role="alert">
                <h4 class="alert-heading">¡Bienvenido, {{usuarioSesion.nombre}}!</h4>
                <p class="mb-0">Tu sesión está activa.</p>
            </div>
        {{else}}
            <div class="row justify-content-center">
                <div class="col-md-4 mb-3">
                    <a href="/login" class="btn btn-primary btn-lg w-100">
                        🔑 Iniciar Sesión
                    </a>
                </div>
            </div>
        {{/if}}
    </div>
</div>